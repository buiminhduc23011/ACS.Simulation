{
  "name": "Full System Stress Test",
  "description": "Kiểm tra toàn diện: di chuyển, pin, lỗi, chaos mạng và khôi phục hệ thống",
  "version": "1.0",
  "steps": [
    {
      "type": "Log",
      "message": "=== Bắt đầu Full System Stress Test ==="
    },
    {
      "type": "Log",
      "message": "--- Phase 1: Khởi tạo AGV ---"
    },
    {
      "type": "SetPosition",
      "agvId": "",
      "x": 0.0,
      "y": 0.0,
      "theta": 0.0
    },
    {
      "type": "SetBattery",
      "agvId": "",
      "level": 100.0
    },
    {
      "type": "SetSpeed",
      "agvId": "",
      "speed": 1.0
    },
    {
      "type": "Wait",
      "durationMs": 1000
    },
    {
      "type": "Log",
      "message": "--- Phase 2: Di chuyển bình thường ---"
    },
    {
      "type": "SetPosition",
      "agvId": "",
      "x": 3.0,
      "y": 0.0,
      "theta": 0.0
    },
    {
      "type": "Wait",
      "durationMs": 1000
    },
    {
      "type": "SetPosition",
      "agvId": "",
      "x": 3.0,
      "y": 3.0,
      "theta": 1.5708
    },
    {
      "type": "Wait",
      "durationMs": 1000
    },
    {
      "type": "Log",
      "message": "--- Phase 3: Chaos mạng trong khi di chuyển ---"
    },
    {
      "type": "SetChaos",
      "agvId": "",
      "latencyMinMs": 100,
      "latencyMaxMs": 300,
      "packetLossPercent": 15,
      "comment": "Mạng không ổn định"
    },
    {
      "type": "SetPosition",
      "agvId": "",
      "x": 6.0,
      "y": 3.0,
      "theta": 0.0
    },
    {
      "type": "Wait",
      "durationMs": 2000
    },
    {
      "type": "SetPosition",
      "agvId": "",
      "x": 6.0,
      "y": 6.0,
      "theta": 1.5708
    },
    {
      "type": "Wait",
      "durationMs": 2000
    },
    {
      "type": "Log",
      "message": "--- Phase 4: Lỗi trong khi mạng không ổn định ---"
    },
    {
      "type": "InjectError",
      "agvId": "",
      "templateName": "OBSTACLE_DETECTED",
      "comment": "Phát hiện vật cản"
    },
    {
      "type": "Wait",
      "durationMs": 3000
    },
    {
      "type": "ClearError",
      "agvId": ""
    },
    {
      "type": "SetChaos",
      "agvId": "",
      "latencyMinMs": 0,
      "latencyMaxMs": 0,
      "packetLossPercent": 0,
      "comment": "Phục hồi mạng"
    },
    {
      "type": "Wait",
      "durationMs": 1000
    },
    {
      "type": "Log",
      "message": "--- Phase 5: Pin yếu + Emergency Stop ---"
    },
    {
      "type": "SetBattery",
      "agvId": "",
      "level": 10.0,
      "comment": "Pin rất thấp"
    },
    {
      "type": "InjectError",
      "agvId": "",
      "templateName": "BATTERY_LOW"
    },
    {
      "type": "Wait",
      "durationMs": 2000
    },
    {
      "type": "InjectError",
      "agvId": "",
      "templateName": "EMERGENCY_STOP",
      "comment": "Emergency stop khi pin yếu"
    },
    {
      "type": "Wait",
      "durationMs": 3000
    },
    {
      "type": "Assert",
      "agvId": "",
      "condition": "haserrors == true",
      "timeoutMs": 3000
    },
    {
      "type": "Log",
      "message": "--- Phase 6: Ngắt kết nối ---"
    },
    {
      "type": "Disconnect",
      "agvId": "",
      "durationMs": 5000,
      "comment": "Mất kết nối 5 giây"
    },
    {
      "type": "Wait",
      "durationMs": 6000
    },
    {
      "type": "Log",
      "message": "--- Phase 7: Khôi phục hoàn toàn ---"
    },
    {
      "type": "ClearError",
      "agvId": "",
      "comment": "Xóa tất cả lỗi"
    },
    {
      "type": "SetBattery",
      "agvId": "",
      "level": 100.0,
      "comment": "Sạc đầy pin"
    },
    {
      "type": "SetSpeed",
      "agvId": "",
      "speed": 1.0
    },
    {
      "type": "SetPosition",
      "agvId": "",
      "x": 0.0,
      "y": 0.0,
      "theta": 0.0,
      "comment": "Quay về vị trí gốc"
    },
    {
      "type": "Wait",
      "durationMs": 2000
    },
    {
      "type": "Assert",
      "agvId": "",
      "condition": "haserrors == false",
      "timeoutMs": 5000,
      "comment": "Xác nhận hệ thống đã phục hồi"
    },
    {
      "type": "Assert",
      "agvId": "",
      "condition": "battery > 90",
      "timeoutMs": 3000,
      "comment": "Xác nhận pin đầy"
    },
    {
      "type": "Log",
      "message": "=== Hoàn thành Full System Stress Test ==="
    }
  ]
}
