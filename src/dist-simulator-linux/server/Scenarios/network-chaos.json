{
  "name": "Network Chaos Test",
  "description": "Kiểm tra khả năng chịu lỗi mạng: latency cao, mất gói tin và ngắt kết nối",
  "version": "1.0",
  "steps": [
    {
      "type": "Log",
      "message": "=== Bắt đầu kiểm tra Network Chaos ==="
    },
    {
      "type": "SetPosition",
      "agvId": "",
      "x": 2.0,
      "y": 2.0,
      "theta": 0.0,
      "comment": "Đặt vị trí ban đầu"
    },
    {
      "type": "SetSpeed",
      "agvId": "",
      "speed": 1.0
    },
    {
      "type": "Wait",
      "durationMs": 1000
    },
    {
      "type": "Log",
      "message": ">>> Giai đoạn 1: Thêm latency nhẹ (50-100ms)"
    },
    {
      "type": "SetChaos",
      "agvId": "",
      "latencyMinMs": 50,
      "latencyMaxMs": 100,
      "packetLossPercent": 0,
      "comment": "Latency nhẹ, không mất gói"
    },
    {
      "type": "Wait",
      "durationMs": 3000
    },
    {
      "type": "Log",
      "message": ">>> Giai đoạn 2: Latency cao + mất gói 10%"
    },
    {
      "type": "SetChaos",
      "agvId": "",
      "latencyMinMs": 200,
      "latencyMaxMs": 500,
      "packetLossPercent": 10,
      "comment": "Mạng không ổn định"
    },
    {
      "type": "Wait",
      "durationMs": 4000
    },
    {
      "type": "Log",
      "message": ">>> Giai đoạn 3: Mất gói 30% - mạng rất kém"
    },
    {
      "type": "SetChaos",
      "agvId": "",
      "latencyMinMs": 500,
      "latencyMaxMs": 1000,
      "packetLossPercent": 30,
      "comment": "Mạng rất kém"
    },
    {
      "type": "Wait",
      "durationMs": 4000
    },
    {
      "type": "Log",
      "message": ">>> Giai đoạn 4: Ngắt kết nối hoàn toàn 5 giây"
    },
    {
      "type": "Disconnect",
      "agvId": "",
      "durationMs": 5000,
      "comment": "Mất kết nối 5 giây"
    },
    {
      "type": "Wait",
      "durationMs": 6000
    },
    {
      "type": "Log",
      "message": ">>> Phục hồi mạng - xóa chaos"
    },
    {
      "type": "SetChaos",
      "agvId": "",
      "latencyMinMs": 0,
      "latencyMaxMs": 0,
      "packetLossPercent": 0,
      "comment": "Phục hồi mạng bình thường"
    },
    {
      "type": "Wait",
      "durationMs": 2000
    },
    {
      "type": "Assert",
      "agvId": "",
      "condition": "isconnected == true",
      "timeoutMs": 10000,
      "comment": "Xác nhận AGV đã kết nối lại"
    },
    {
      "type": "Log",
      "message": "=== Hoàn thành kiểm tra Network Chaos ==="
    }
  ]
}
