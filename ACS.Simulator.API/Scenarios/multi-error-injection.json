{
  "name": "Multi-Error Injection Test",
  "description": "Kiểm tra inject nhiều loại lỗi khác nhau và quy trình xử lý từng lỗi",
  "version": "1.0",
  "steps": [
    {
      "type": "Log",
      "message": "=== Bắt đầu kiểm tra Multi-Error Injection ==="
    },
    {
      "type": "SetPosition",
      "agvId": "",
      "x": 5.0,
      "y": 5.0,
      "theta": 0.0
    },
    {
      "type": "SetSpeed",
      "agvId": "",
      "speed": 1.5
    },
    {
      "type": "SetBattery",
      "agvId": "",
      "level": 90.0
    },
    {
      "type": "Wait",
      "durationMs": 1000
    },
    {
      "type": "Log",
      "message": ">>> Lỗi 1: Sensor Failure (WARNING) - chỉ báo cáo"
    },
    {
      "type": "InjectError",
      "agvId": "",
      "templateName": "SENSOR_FAILURE"
    },
    {
      "type": "Wait",
      "durationMs": 2000
    },
    {
      "type": "Assert",
      "agvId": "",
      "condition": "haserrors == true",
      "timeoutMs": 3000
    },
    {
      "type": "ClearError",
      "agvId": "",
      "comment": "Xóa lỗi sensor"
    },
    {
      "type": "Wait",
      "durationMs": 1000
    },
    {
      "type": "Log",
      "message": ">>> Lỗi 2: Motor Overheat (WARNING) - giảm tốc 50%"
    },
    {
      "type": "InjectError",
      "agvId": "",
      "templateName": "MOTOR_OVERHEAT"
    },
    {
      "type": "Wait",
      "durationMs": 2000
    },
    {
      "type": "ClearError",
      "agvId": "",
      "comment": "Xóa lỗi motor"
    },
    {
      "type": "Wait",
      "durationMs": 1000
    },
    {
      "type": "Log",
      "message": ">>> Lỗi 3: Obstacle Detected (WARNING) - dừng di chuyển"
    },
    {
      "type": "InjectError",
      "agvId": "",
      "templateName": "OBSTACLE_DETECTED"
    },
    {
      "type": "Wait",
      "durationMs": 3000
    },
    {
      "type": "ClearError",
      "agvId": "",
      "comment": "Xóa lỗi obstacle"
    },
    {
      "type": "Wait",
      "durationMs": 1000
    },
    {
      "type": "Log",
      "message": ">>> Lỗi 4: Localization Lost (FATAL) - mất vị trí"
    },
    {
      "type": "InjectError",
      "agvId": "",
      "templateName": "LOCALIZATION_LOST"
    },
    {
      "type": "Wait",
      "durationMs": 3000
    },
    {
      "type": "ClearError",
      "agvId": "",
      "comment": "Xóa lỗi localization"
    },
    {
      "type": "SetPosition",
      "agvId": "",
      "x": 5.0,
      "y": 5.0,
      "theta": 0.0,
      "comment": "Khôi phục vị trí"
    },
    {
      "type": "Wait",
      "durationMs": 1000
    },
    {
      "type": "Log",
      "message": ">>> Lỗi 5: Load Dropped (FATAL) - rơi hàng"
    },
    {
      "type": "InjectError",
      "agvId": "",
      "templateName": "LOAD_DROPPED"
    },
    {
      "type": "Wait",
      "durationMs": 3000
    },
    {
      "type": "ClearError",
      "agvId": "",
      "comment": "Xóa lỗi load dropped"
    },
    {
      "type": "Wait",
      "durationMs": 1000
    },
    {
      "type": "Log",
      "message": ">>> Lỗi 6: Communication Error (WARNING)"
    },
    {
      "type": "InjectError",
      "agvId": "",
      "templateName": "COMMUNICATION_ERROR"
    },
    {
      "type": "Wait",
      "durationMs": 2000
    },
    {
      "type": "ClearError",
      "agvId": "",
      "comment": "Xóa tất cả lỗi"
    },
    {
      "type": "Wait",
      "durationMs": 1000
    },
    {
      "type": "Assert",
      "agvId": "",
      "condition": "haserrors == false",
      "timeoutMs": 3000,
      "comment": "Xác nhận AGV đã sạch lỗi"
    },
    {
      "type": "Log",
      "message": "=== Hoàn thành kiểm tra Multi-Error Injection ==="
    }
  ]
}
