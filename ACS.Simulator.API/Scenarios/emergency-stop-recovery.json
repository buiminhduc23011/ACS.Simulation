{
  "name": "Emergency Stop & Recovery",
  "description": "Mô phỏng tình huống Emergency Stop và quy trình phục hồi AGV",
  "version": "1.0",
  "steps": [
    {
      "type": "Log",
      "message": "=== Bắt đầu kiểm tra Emergency Stop & Recovery ==="
    },
    {
      "type": "SetPosition",
      "agvId": "",
      "x": 3.0,
      "y": 3.0,
      "theta": 0.0,
      "comment": "AGV đang ở vị trí (3, 3)"
    },
    {
      "type": "SetSpeed",
      "agvId": "",
      "speed": 1.5,
      "comment": "AGV đang di chuyển"
    },
    {
      "type": "SetBattery",
      "agvId": "",
      "level": 80.0,
      "comment": "Pin 80%"
    },
    {
      "type": "Wait",
      "durationMs": 2000
    },
    {
      "type": "Log",
      "message": ">>> Kích hoạt Emergency Stop!"
    },
    {
      "type": "InjectError",
      "agvId": "",
      "templateName": "EMERGENCY_STOP",
      "comment": "Trigger eStop = MANUAL"
    },
    {
      "type": "Wait",
      "durationMs": 3000
    },
    {
      "type": "Assert",
      "agvId": "",
      "condition": "haserrors == true",
      "timeoutMs": 5000,
      "comment": "Xác nhận AGV có lỗi"
    },
    {
      "type": "Log",
      "message": ">>> Bắt đầu quy trình phục hồi..."
    },
    {
      "type": "ClearError",
      "agvId": "",
      "comment": "Xóa tất cả lỗi"
    },
    {
      "type": "Wait",
      "durationMs": 2000
    },
    {
      "type": "Assert",
      "agvId": "",
      "condition": "haserrors == false",
      "timeoutMs": 5000,
      "comment": "Xác nhận AGV đã hết lỗi"
    },
    {
      "type": "SetSpeed",
      "agvId": "",
      "speed": 1.0,
      "comment": "AGV tiếp tục di chuyển với tốc độ an toàn"
    },
    {
      "type": "SetPosition",
      "agvId": "",
      "x": 5.0,
      "y": 5.0,
      "theta": 0.0,
      "comment": "AGV di chuyển đến vị trí mới"
    },
    {
      "type": "Wait",
      "durationMs": 1500
    },
    {
      "type": "Log",
      "message": "=== Hoàn thành kiểm tra Emergency Stop & Recovery ==="
    }
  ]
}
